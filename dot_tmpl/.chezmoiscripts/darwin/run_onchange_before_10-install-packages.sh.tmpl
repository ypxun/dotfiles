#!/bin/bash
# 监控 Brewfile 变化 (SHA256): {{ include (joinPath .chezmoi.workingTree "homebrew/Brewfile") | sha256sum }}
set -eufo pipefail

{{ if .personal -}}
if command -v brew &> /dev/null; then
    echo "🍎 [1/3] macOS (Personal): 正在同步 Homebrew 状态..."
    # --no-upgrade 提速，--cleanup 保持纯净
    brew bundle --no-upgrade --file="{{ joinPath .chezmoi.workingTree "homebrew/Brewfile" }}"
else
    echo "⚠️  未发现 Homebrew，请手动安装后再试。"
fi
{{- else -}}
echo "💡 非个人设备，跳过 Homebrew 全量同步。"
{{- end }}